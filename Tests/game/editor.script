using System;
using System.IO;
using Chinese_Name.Naming.Game;
using UnityEngine;

ScrollWindow.showWindow("world_info");
for (int frame = 0; frame < 150 && ScrollWindow.isAnimationActive(); frame++) await Game.NextFrame();
ScrollWindow.getCurrentWindow().tabs.showTab("chinesename_packs");
await Game.NextFrame();
await Game.NextFrame();
var screenshot = Path.Combine(Environment.GetEnvironmentVariable("CHINESENAME_DEV_OUTPUT"),
    "naming-editor-" + DateTime.UtcNow.ToString("HHmmssfff") + ".png");
ScreenCapture.CaptureScreenshot(screenshot);
for (int frame = 0; frame < 120 && !File.Exists(screenshot); frame++) await Game.NextFrame();
if (!File.Exists(screenshot)) throw new InvalidOperationException("The editor screenshot was not captured.");
return new { screenshot };
