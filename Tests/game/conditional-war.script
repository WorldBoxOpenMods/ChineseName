float headingTop = RectTransformUtility.CalculateRelativeRectTransformBounds(view, Find<RectTransform>("AllArrangementsTitle")).max.y;
float scrollRange = scrollRect.content.rect.height - view.rect.height;
if (scrollRange > 0)
{
    scrollRect.StopMovement();
    scrollRect.verticalNormalizedPosition = Mathf.Clamp01(scrollRect.verticalNormalizedPosition +
        (headingTop - Mathf.Min(view.rect.yMax, previewBottom) + 3) / scrollRange);
}
await Frames();
