Check(conquestTip == defaultTip && conquestTip.description.text == "临川国-松岭国之战" && Preview() == "临川国雪耻之役" &&
    conquestTip.description.fontSize == conquestTip.name.fontSize &&
    conditionIcons.Length == 10 && conditionIcons[1].texture == SpriteTextureLoader.getSprite("wars/war_conquest").texture &&
    glyphIcons.Select(icon => icon.texture).SequenceEqual(
        conquestOrder.Select(id => AssetManager.onomastics_library.get(id).getSprite().texture)) &&
    conquestTip.transform.Find("ConditionIcons/Traits").GetComponent<FlexibleOneRowGrid>() != null,
    "The hovered row did not show its own name and its condition and glyph icons in order.");

await Mouse("move", Find<Text>("PreviewName"));
var originalWorld = service.GetWorld();
var sampleWorld = service.GetWorld();
var suffixes = new[] { "之战", "之役", "会战", "鏖战", "争战", "大战", "决战", "连战", "交锋", "对阵",
    "追击战", "夺城战", "渡河战", "平原战", "边境战", "关隘战", "攻城战", "围城战", "山口战", "破阵战" };
sampleWorld.Cultures[culture.id].Arrangements[warType].Single(item => item.Id == conquestId).Cards.Template =
    new string(conquestOrder.Select(Code).ToArray()) + "|1:" + string.Join(" ", suffixes);
WorldNamingStore.Apply(sampleWorld);
await Frames();
var variedTip = await HoverArrangement(conquestId);
var names = variedTip.description.text.Split(new[] { '\n', '　' }, StringSplitOptions.RemoveEmptyEntries);
Check(names.Length == 12 && names.Distinct().Count() == names.Length &&
    names.All(name => suffixes.Contains(name.Replace("临川国-松岭国", "")) && name.StartsWith("临川国-松岭国")) &&
    variedTip.description.text.Contains('\n') && Preview() == "临川国雪耻之役",
    "The tooltip did not lay out twelve distinct samples from the hovered arrangement.");
string tooltipScreenshot = Path.Combine(output, "war-arrangement-tooltip.png");
ScreenCapture.CaptureScreenshot(tooltipScreenshot);
await Frames(2);
await Mouse("move", Find<Text>("PreviewName"));
WorldNamingStore.Apply(originalWorld);
await Frames();
await ScrollTo((RectTransform)tab.parent_asset_groups.parent);
string paletteScreenshot = Path.Combine(output, "war-arrangement-palettes.png");
ScreenCapture.CaptureScreenshot(paletteScreenshot);
await Frames(2);
await Click("ArrangementAdd");
string temporaryId = Saved().Last().Id;
await Click("ArrangementDelete." + temporaryId);
Check(NamingJson.Write(Saved()) == NamingJson.Write(arrangements),
    "The title's delete button did not remove only the selected arrangement.");
var folder = Path.Combine(output, "conditional-war-save");
Directory.CreateDirectory(folder);
world.units.checkLists(); world.languages.checkLists(); world.cultures.checkLists(); world.kingdoms.checkLists();
world.wars.checkLists();
SaveManager.saveWorldToDirectory(folder);
File.WriteAllLines(Path.Combine(folder, "ids.txt"), new[] { culture.id, founder.getID(), kingdom.id, rivalKingdom.id,
    war.id, spite.id, revolt.id }.Select(id => id.ToString()));
File.WriteAllText(Path.Combine(folder, "arrangements.json"), NamingJson.Write(arrangements));
return new { previews, actual = new[] { war.name, spite.name, revolt.name }, fallback = empty.Text,
    mouseEvents = seq, screenshot, paletteScreenshot, tooltipScreenshot, folder };
