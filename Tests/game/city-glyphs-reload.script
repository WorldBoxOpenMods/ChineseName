using System;
using System.IO;
using System.Linq;
using Chinese_Name.Naming;
using UnityEngine;
using UnityEngine.UI;
void Check(bool yes, string why) { if (!yes) throw new InvalidOperationException(why); }
var output = new DirectoryInfo(Environment.GetEnvironmentVariable("CHINESENAME_DEV_OUTPUT"));
var save = Directory.EnumerateFiles(output.Parent.Parent.FullName, "map.wbox", SearchOption.AllDirectories)
    .Where(path => path.EndsWith("/city-glyph-save/map.wbox")).OrderBy(path => path, StringComparer.Ordinal).Last();
var ids = File.ReadAllLines(Path.Combine(Path.GetDirectoryName(save), "expected.txt")).Select(long.Parse).ToArray();
SaveManager.loadMapFromBytes(File.ReadAllBytes(save));
for (int i = 0; i < 1000 && SmoothLoader.isLoading(); i++) await Game.NextFrame();
Check(!SmoothLoader.isLoading(), "Timed out loading the map.");
var world = World.world;
world.console.Hide();
var culture = world.cultures.get(ids[0]);
var city = world.cities.get(ids[2]);
Check(city?.name == "澄江-州", "Existing city name did not survive.");
var expected = new[] { "group_1", "hyphen", "group_2" };
var name = NamingApi.Current.Generate(new NameRequest("worldbox:city", 0, ids[0], ids[1]));
Check(name.Text == city.name, "Generation after reload differs.");
ScrollWindow.hideAllEvent(pWithAnimation: false);
SelectedMetas.selected_city = city;
SelectedMetas.selected_culture = culture;
ScrollWindow.showWindow("culture");
var shell = ScrollWindow.getCurrentWindow();
shell.tabs.showTab("Onomastics");
var tab = shell.GetComponentInChildren<OnomasticsTab>();
tab._tab_groups._toggles.Find(item => item.name == "tab_onomastics_city").toggle.click();
for (int i = 0; i < 120 && ScrollWindow.isAnimationActive(); i++) await Game.NextFrame();
for (int i = 0; i < 12; i++) await Game.NextFrame();
Check(tab.parent_asset_specials.gameObject.activeInHierarchy &&
    tab.getOnomasticsData().getGroupString("group_2") == "州" &&
    tab.getOnomasticsData().getFullTemplateData().SequenceEqual(expected), "Editor did not reopen saved layout.");
var line = shell.transform.FindRecursive("PreviewName");
var preview = line.GetComponent<Text>().text;
Check(preview == name.Text, "Preview after reload differs: " + preview);
return new { save, existing = city.name, generated = name.Text, preview, order = expected };
