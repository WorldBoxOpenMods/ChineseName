using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using Chinese_Name.Naming;
using Chinese_Name.Naming.Game;
using UnityEngine.UI;

void Check(bool yes, string why) { if (!yes) throw new InvalidOperationException(why); }
var output = new DirectoryInfo(Environment.GetEnvironmentVariable("CHINESENAME_DEV_OUTPUT"));
var save = Directory.EnumerateFiles(output.Parent.Parent.FullName, "map.wbox", SearchOption.AllDirectories)
    .Where(path => path.EndsWith("/culture-extra-save/map.wbox")).OrderBy(path => path, StringComparer.Ordinal).Last();
var ids = File.ReadAllLines(Path.Combine(Path.GetDirectoryName(save), "expected.txt")).Select(long.Parse).ToArray();
SaveManager.loadMapFromBytes(File.ReadAllBytes(save));
for (int i = 0; i < 1000 && SmoothLoader.isLoading(); i++) await Game.NextFrame();
Check(!SmoothLoader.isLoading(), "Timed out loading the map.");
Config.paused = true;

var world = World.world;
var parent = world.cultures.get(ids[0]);
var other = world.cultures.get(ids[1]);
var founder = world.units.get(ids[3]);
var kingdom = world.kingdoms.get(ids[4]);
var war = world.wars.get(ids[5]);
Check(war?.name == "江门云津国征伐" && kingdom?.getMotto() == "守望同舟", "The existing names changed after loading.");
string storedAlliance = world.alliances.get(ids[6])?.name;
string storedArmy = world.armies.get(ids[7])?.name;
string storedItem = world.items.get(ids[8])?.name;
Check(storedAlliance == "两川同盟" && storedArmy == "青岩卫" && storedItem == "传家宝",
    $"The saved objects reopened as alliance {storedAlliance}, army {storedArmy}, item {storedItem}.");
Check(world.plots.get(ids[9])?.name == "河谷之议", "The saved plot lost its edit.");

var child = world.cultures.newCulture(founder, false);
child.cloneAndEvolveOnomastics(parent);
world.cultures.checkLists();
var service = NamingApi.Current;
var config = service.GetWorld();
var expected = new[] {
    (Id: "war", Template: "201|2:江门", Kind: "normal", Name: "江门云津国征伐"),
    (Id: "alliance", Template: "0|0:两川同盟", Kind: "", Name: "两川同盟"),
    (Id: "army", Template: "01|0:青岩", Kind: "", Name: "青岩卫"),
    (Id: "book", Template: "01|0:同舟", Kind: "book_name_warfare_manual", Name: "同舟略"),
    (Id: "motto", Template: "0|0:守望同舟", Kind: "alliance", Name: "守望同舟"),
    (Id: "item", Template: "0|0:青炉", Kind: "reforge", Name: "青炉"),
    (Id: "plot", Template: "0|0:河谷之议", Kind: "language_divergence", Name: "河谷之议"),
};
NameResult Generate(long culture, string id, string kind)
{
    var inputs = new Dictionary<string, object> { ["kind"] = kind, ["origin"] = "云津国" };
    if (id == "alliance") { inputs["founder-short"] = "云津"; inputs["partner-short"] = "松岭"; }
    if (id == "item") { inputs["stage"] = kind; inputs["equipment"] = "sword"; }
    if (id == "plot") inputs["plot"] = "language-divergence";
    return service.Generate(new NameRequest("worldbox:" + id, 0, culture, ids[2], inputs));
}
foreach (var entry in expected)
{
    foreach (var culture in new[] { parent, child })
    {
        Check(config.Cultures[culture.id].DefaultArrangementEdits.Keys.Any(key => key.StartsWith("worldbox:" + entry.Id + "/")) &&
            Generate(culture.id, entry.Id, entry.Kind).Text == entry.Name,
            entry.Id + " was lost on reload or culture divergence.");
    }
    Check(Generate(other.id, entry.Id, entry.Kind).Text != entry.Name, entry.Id + " leaked into another culture.");
}

world.console.Hide();
ScrollWindow.hideAllEvent(pWithAnimation: false);
SelectedUnit.select(founder);
SelectedMetas.selected_culture = parent;
ScrollWindow.showWindow("culture");
var shell = ScrollWindow.getCurrentWindow();
shell.tabs.showTab("Onomastics");
var tab = shell.GetComponentInChildren<OnomasticsTab>();
tab._tab_groups._toggles.Single(item => item.name == "tab_onomastics_war").toggle.click();
for (int i = 0; i < 150 && ScrollWindow.isAnimationActive(); i++) await Game.NextFrame();
for (int i = 0; i < 12; i++) await Game.NextFrame();
var preview = shell.transform.FindRecursive("PreviewName")?.GetComponent<Text>()?.text;
Check(preview == "江门临川国征伐" && tab.getOnomasticsData().getShortTemplate() == expected[0].Template,
    "Reopening the war editor produced " + preview);
foreach (var entry in expected.Skip(1))
{
    tab._tab_groups._toggles.Single(item => item.name == "tab_onomastics_" + entry.Id).toggle.click();
    for (int i = 0; i < 12; i++) await Game.NextFrame();
    string sample = entry.Id == "book" ? "同舟纪" : entry.Name;
    Check(tab.getOnomasticsData().getShortTemplate() == entry.Template &&
        shell.transform.FindRecursive("PreviewName").GetComponent<Text>().text == sample,
        "The reloaded original editor did not show " + entry.Id + ": " + shell.transform.FindRecursive("PreviewName").GetComponent<Text>().text);
}
tab._tab_groups._toggles.Single(item => item.name == "tab_onomastics_war").toggle.click();
for (int i = 0; i < 12; i++) await Game.NextFrame();
tab.resetTemplate();
for (int i = 0; i < 12; i++) await Game.NextFrame();
Check(Generate(parent.id, "war", "normal").Text == "云津国征伐" &&
      Generate(child.id, "war", "normal").Text == "江门云津国征伐" &&
      war.name == "江门云津国征伐", "Reset changed another culture or an existing name.");
return new { save, preview, restored = expected.Select(entry => entry.Id).ToArray(), child = child.name, previousWar = war.name };
