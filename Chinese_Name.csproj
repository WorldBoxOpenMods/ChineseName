<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRootPath Condition="'$(GameRootPath)' == ''">$(MSBuildThisFileDirectory)../..</GameRootPath>
    <GameManagedPath>$(GameRootPath)/worldbox_Data/Managed</GameManagedPath>
    <GameModsPath>$(GameRootPath)/worldbox_Data/StreamingAssets/mods</GameModsPath>
    <FrameworkPathOverride>$(GameManagedPath)</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameModsPath)/NML/Assembly-CSharp-Publicized.dll" />
    <Reference Include="0Harmony" HintPath="$(GameModsPath)/NML/Assemblies/0Harmony.dll" />
    <Reference Include="NeoModLoader" HintPath="$(GameModsPath)/NeoModLoader.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManagedPath)/Newtonsoft.Json.dll" />
    <Reference Include="netstandard" HintPath="$(GameManagedPath)/netstandard.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedPath)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManagedPath)/UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManagedPath)/UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedPath)/UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManagedPath)/UnityEngine.UIModule.dll" />
    <Reference Include="Unity.Mathematics" HintPath="$(GameManagedPath)/Unity.Mathematics.dll" />
  </ItemGroup>

  <Target Name="RequireGameReferences" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(GameModsPath)/NML/Assembly-CSharp-Publicized.dll')">
    <Error Text="Set GameRootPath to a WorldBox installation with NML and its publicized game assembly." />
  </Target>
</Project>
